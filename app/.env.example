# Copia este archivo como .env.local para cambiar la configuración en tu equipo.

# API del plugin pio (por defecto, la de turismocazorla.info)
# VITE_PIO_API=https://turismocazorla.info/wp-json/pio/v1

# Solo en desarrollo (npm run dev): usar siempre los datos de demostración en vez de la API.
# En producción se ignora: la app nunca usa datos de demostración.
# VITE_PIO_DATOS=demo
